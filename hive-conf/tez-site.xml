<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>

  <!-- Doit pointer EXACTEMENT vers le même chemin que celui uploadé par tez-init
       (service du cluster Hadoop) : hadoop/init-tez.sh -->
  <property>
    <name>tez.lib.uris</name>
    <value>hdfs://namenode:8020/apps/tez/tez.tar.gz</value>
  </property>

  <property>
    <name>tez.use.cluster.hadoop-libs</name>
    <value>true</value>
  </property>

  <!-- Mode standard : DAG AppMaster lancé par YARN à chaque session -->
  <property>
    <name>tez.am.mode.session</name>
    <value>false</value>
  </property>

  <property>
    <name>tez.local.mode</name>
    <value>false</value>
  </property>

  <property>
    <name>tez.am.resource.memory.mb</name>
    <value>512</value>
  </property>

  <property>
    <name>tez.task.resource.memory.mb</name>
    <value>512</value>
  </property>

  <property>
    <name>tez.am.launch.cmd-opts</name>
    <value>-Xmx400m</value>
  </property>

  <property>
    <name>tez.task.launch.cmd-opts</name>
    <value>-Xmx400m</value>
  </property>

  <property>
    <name>tez.staging-dir</name>
    <value>/tmp/tez/staging</value>
  </property>

  <property>
    <name>tez.am.tez-ui.webservice.enable</name>
    <value>false</value>
  </property>

</configuration>
